# 复制为本项目 .env 并自行填写。令牌不会写入运行报告；.env 已被 Git 忽略。
BENCH_RUN_TOKEN=
# 提交工作区的父目录，例如 C:/Users/A/Documents/ChatGPT/Forever_Skywalker_AI_Benchmark/data/submissions
BENCH_SUBMISSIONS_DIR=
# 留空时使用项目 data/runs；CLI 与 API 使用同一个运行目录。
BENCH_RUN_DIR=
BENCH_PROFILE=local
# Linux 镜像配置由 pnpm container:build 写入 data/container/runtime.json；使用其中不可变 image ID。
BENCH_IMAGE=
BENCH_IMAGE_DIGEST=

# DSH 自动作答：pnpm dsh:compare --model <你在 DSH 使用的模型 ID>。
# ROOT 留空尝试用户 Documents/deepseek-harness；须有同版本 SDK/CLI 构建。
BENCH_DSH_ROOT=
# HOME 留空使用 DSH_HOME 或用户 .dsh；由 DSH 自己读取已有供应商配置，本项目不复制密钥。
BENCH_DSH_HOME=
BENCH_DSH_PROFILE=sdk
BENCH_DSH_PROVIDER=deepseek-official
# 可在此保存默认作答模型，然后直接 pnpm dsh:compare。
BENCH_DSH_MODEL=
# DSH 工具/行为预设（与思考等级独立）：standard/标准、ptc/PTC、minimal/极简、cordis/创造。
# 多个用逗号分隔；命令行 --preset 或 --presets 优先。
BENCH_DSH_PRESETS=standard
# 单个思考等级，例如 high；留空沿用 off/high 比较。命令行 --reasoning 或 --modes 优先。
BENCH_DSH_REASONING_EFFORT=
# 报告父目录，留空使用本项目 data/experiments；每次新建唯一报告子目录。
# 最终只保留 Markdown、experiment.json 和 evidence.json.gz，运行临时数据清理。
BENCH_DSH_REPORT_DIR=

# 独立裁判：openai / anthropic / gemini / deepseek / qwen / xai / moonshot / zhipu / openai-compatible。
# 完整参数矩阵与每厂商配置见 docs/judge-providers.md；没有配置时保持待评。
BENCH_JUDGE_PROVIDER=openai-compatible
BENCH_JUDGE_ENDPOINT=
BENCH_JUDGE_MODEL=
BENCH_JUDGE_TOKEN=
# 留空按 provider 选择原生协议；OpenAI 可显式改为 chat-completions。
BENCH_JUDGE_API=
BENCH_JUDGE_PROMPT_VERSION=review-v1
BENCH_JUDGE_MAX_CALLS=2
BENCH_JUDGE_MAX_INPUT_TOKENS=60000
BENCH_JUDGE_MAX_OUTPUT_TOKENS=4000
# 每轮发送上限，留空在创建裁判时以 总输出预算/调用预算 固定，第二轮不会自适应改变。
BENCH_JUDGE_MAX_TOKENS_PER_CALL=
BENCH_JUDGE_TIMEOUT_MS=60000
# 裁判思考等级在这里配置，与 BENCH_DSH_REASONING_EFFORT 独立。
# DeepSeek 裁判可用 low/high/max，配 BENCH_JUDGE_THINKING=enabled。
# 关闭 DeepSeek 裁判思考用 THINKING=disabled 并清空 EFFORT，不能写 off。
# 全部可选且按厂商/模型校验；其它供应商见 docs/judge-providers.md。
BENCH_JUDGE_REASONING_EFFORT=
BENCH_JUDGE_REASONING_MODE=
BENCH_JUDGE_THINKING=
BENCH_JUDGE_THINKING_BUDGET=
BENCH_JUDGE_TEMPERATURE=
BENCH_JUDGE_TOP_P=
BENCH_JUDGE_TOP_K=
BENCH_JUDGE_SEED=
BENCH_JUDGE_VERBOSITY=
# json-object 或 prompt-json。Claude/GLM 默认 prompt-json；部分 Qwen 思考配置同样使用 prompt-json。
BENCH_JUDGE_OUTPUT_FORMAT=
# true/false；Kimi 默认 true，其余默认 false。当前仅 Chat Completions 支持流式。
BENCH_JUDGE_STREAM=
# 1 表示执行 2 轮预热和至少 7 轮配对性能测量；耗时显著高于仅验证正确性。
BENCH_MEASURE_PERFORMANCE=1
