{
  "schemaVersion": "0.1.0",
  "taskId": "STATE-03",
  "taskVersion": "0.3.0",
  "title": "检查点恢复和不可重复入账",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/STATE-03/checks",
    "referencePatch": "graders/STATE-03/reference.patch",
    "alternative": "graders/STATE-03/alternative",
    "defectDetectors": [
      "hidden/checkpoint-only-advances-and-matches-journal-length",
      "hidden/confirmed-prefix-is-append-only",
      "hidden/entries-appended-by-others-are-replayed-once",
      "hidden/process-exit-after-journal-append-is-idempotent",
      "hidden/recover-is-idempotent-across-repeated-calls",
      "hidden/safe-integer-transaction-validates-before-write",
      "hidden/seeded-replay-matches-independent-balance",
      "public/acknowledgement-loss-reconciles-persisted-transaction",
      "public/crash-recovery-replays-journal-once",
      "public/recover-does-not-double-count",
      "public/recovery-publishes-only-completely-valid-snapshot",
      "public/replays-entries-appended-by-others",
      "public/transaction-identity-preserves-original-receipt"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/applies-entries-and-tracks-checkpoint",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "入账累加余额并推进检查点。"
    },
    {
      "id": "public/recover-does-not-double-count",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "重复 recover 不得重复入账。"
    },
    {
      "id": "public/crash-recovery-replays-journal-once",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "重启后每个条目只入账一次。"
    },
    {
      "id": "public/replays-entries-appended-by-others",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "外部追加的条目能被重放且只一次。"
    },
    {
      "id": "public/rejects-invalid-journal-entries",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "非法条目抛 LedgerError。"
    },
    {
      "id": "public/transaction-identity-preserves-original-receipt",
      "kind": "public",
      "group": "behavior",
      "weight": 2,
      "critical": true,
      "summary": "跨后续交易重试返回原回执，同键不同金额不能被静默复用。"
    },
    {
      "id": "public/acknowledgement-loss-reconciles-persisted-transaction",
      "kind": "public",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "append持久化后抛错，重新读取事实确认该事务而不重复入账。"
    },
    {
      "id": "public/recovery-publishes-only-completely-valid-snapshot",
      "kind": "public",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "恢复遇到坏尾记录时余额、checkpoint与去重信息都不得部分推进。"
    },
    {
      "id": "hidden/safe-integer-transaction-validates-before-write",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "safe integer transaction validates before write"
    },
    {
      "id": "hidden/confirmed-prefix-is-append-only",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "confirmed prefix is append only"
    },
    {
      "id": "hidden/journal-rejection-without-write-retains-error-and-state",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "journal rejection without write retains error and state"
    },
    {
      "id": "hidden/process-exit-after-journal-append-is-idempotent",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "process exit after journal append is idempotent"
    },
    {
      "id": "hidden/seeded-replay-matches-independent-balance",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "seeded replay matches independent balance"
    },
    {
      "id": "hidden/apply-appends-accumulates-and-advances-checkpoint",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "apply appends accumulates and advances checkpoint"
    },
    {
      "id": "hidden/recover-is-idempotent-across-repeated-calls",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "recover is idempotent across repeated calls"
    },
    {
      "id": "hidden/restart-on-same-journal-replays-each-entry-once",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "restart on same journal replays each entry once"
    },
    {
      "id": "hidden/entries-appended-by-others-are-replayed-once",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "entries appended by others are replayed once"
    },
    {
      "id": "hidden/invalid-entries-are-rejected-with-the-offending-text",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "invalid entries are rejected with the offending text"
    },
    {
      "id": "hidden/checkpoint-only-advances-and-matches-journal-length",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "checkpoint only advances and matches journal length"
    }
  ]
}
