{
  "schemaVersion": "0.1.0",
  "taskId": "STATE-02",
  "taskVersion": "0.3.0",
  "title": "状态迁移与旧版本契约",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/STATE-02/checks",
    "referencePatch": "graders/STATE-02/reference.patch",
    "alternative": "graders/STATE-02/alternative",
    "defectDetectors": [
      "hidden/batch-input-and-output-do-not-alias-state",
      "hidden/migration-is-idempotent-for-every-state",
      "hidden/mixed-version-batch-preserves-order-and-is-idempotent",
      "hidden/unsupported-versions-stringify-exactly",
      "hidden/v1-maps-only-the-frozen-names",
      "hidden/v2-accepts-only-exact-state-names",
      "public/batch-failure-preserves-confirmed-snapshot",
      "public/duplicate-key-is-atomic-domain-error",
      "public/migrates-v1-status-names",
      "public/migration-is-idempotent",
      "public/rejects-invalid-snapshots",
      "public/rejects-unknown-version"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/passes-through-v2",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "合法 v2 快照原样返回。"
    },
    {
      "id": "public/migrates-v1-status-names",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "v1 旧状态名按冻结映射转换。"
    },
    {
      "id": "public/rejects-unknown-version",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "未知版本抛 UnsupportedVersionError。"
    },
    {
      "id": "public/rejects-invalid-snapshots",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "非法结构与非法状态名。"
    },
    {
      "id": "public/migration-is-idempotent",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "迁移幂等。"
    },
    {
      "id": "public/batch-failure-preserves-confirmed-snapshot",
      "kind": "public",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "迁移中途失败定位原条目，全部确认状态保持不变。"
    },
    {
      "id": "public/duplicate-key-is-atomic-domain-error",
      "kind": "public",
      "group": "boundary",
      "weight": 2,
      "critical": true,
      "summary": "同批次重复键（含原型名）不能覆盖或部分发布。"
    },
    {
      "id": "hidden/mixed-version-batch-preserves-order-and-is-idempotent",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "mixed version batch preserves order and is idempotent"
    },
    {
      "id": "hidden/batch-input-and-output-do-not-alias-state",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "batch input and output do not alias state"
    },
    {
      "id": "hidden/v2-accepts-only-exact-state-names",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "v2 accepts only exact state names"
    },
    {
      "id": "hidden/v1-maps-only-the-frozen-names",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "v1 maps only the frozen names"
    },
    {
      "id": "hidden/unsupported-versions-stringify-exactly",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "unsupported versions stringify exactly"
    },
    {
      "id": "hidden/non-object-inputs-are-invalid",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "non object inputs are invalid"
    },
    {
      "id": "hidden/migration-is-idempotent-for-every-state",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "migration is idempotent for every state"
    }
  ]
}
