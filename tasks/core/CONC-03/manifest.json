{
  "schemaVersion": "0.1.0",
  "taskId": "CONC-03",
  "taskVersion": "0.3.0",
  "title": "多资源锁顺序和饥饿控制",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/CONC-03/checks",
    "referencePatch": "graders/CONC-03/reference.patch",
    "alternative": "graders/CONC-03/alternative",
    "defectDetectors": [
      "hidden/conflict-transitivity-and-disjoint-bypass",
      "hidden/fifo-order-is-strictly-first-come-first-served",
      "hidden/newcomers-cannot-jump-waiting-queue",
      "hidden/preaborted-and-empty-request",
      "hidden/ten-waiters-are-served-in-order",
      "public/atomic-bundle-and-disjoint-progress",
      "public/cancel-unblocks-overlap",
      "public/first-come-first-served",
      "public/newcomers-cannot-jump-the-queue"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/grants-when-free",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "空闲时立即授予并正确统计等待者。"
    },
    {
      "id": "public/first-come-first-served",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "释放时把资源交给队首。"
    },
    {
      "id": "public/newcomers-cannot-jump-the-queue",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "队列非空时新请求不得插队。"
    },
    {
      "id": "public/release-is-idempotent",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "Release 幂等。"
    },
    {
      "id": "public/resources-are-independent",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "不同资源互不影响。"
    },
    {
      "id": "public/atomic-bundle-and-disjoint-progress",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "多资源整体交接，互不冲突资源继续前进。"
    },
    {
      "id": "public/cancel-unblocks-overlap",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "取消等待请求同步释放排队约束。"
    },
    {
