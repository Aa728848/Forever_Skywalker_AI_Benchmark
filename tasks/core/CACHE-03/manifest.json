{
  "schemaVersion": "0.1.0",
  "taskId": "CACHE-03",
  "taskVersion": "0.3.0",
  "title": "失效期间的在途旧结果",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/CACHE-03/checks",
    "referencePatch": "graders/CACHE-03/reference.patch",
    "alternative": "graders/CACHE-03/alternative",
    "defectDetectors": [
      "hidden/failed-load-is-not-cached-and-can-be-retried",
      "hidden/multikey-retries-invalidated-cut",
      "hidden/new-success-survives-late-old-success",
      "hidden/only-the-last-generation-may-occupy-the-cache",
      "hidden/rejected-current-generation-is-retryable",
      "hidden/stale-inflight-result-still-reaches-its-caller",
      "hidden/synchronous-source-error-is-a-rejection",
      "public/discards-inflight-result-invalidated-before-settle",
      "public/second-invalidate-during-flight-keeps-latest-request"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/caches-on-miss-and-reuses-hit",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "未命中加载、命中共用同一 promise。"
    },
    {
      "id": "public/invalidate-forces-reload",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "失效后必然重新加载并推进版本。"
    },
    {
      "id": "public/discards-inflight-result-invalidated-before-settle",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "在途中被失效的旧结果不得入缓存，但要返回给调用方。"
    },
    {
      "id": "public/second-invalidate-during-flight-keeps-latest-request",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "多次失效时只有最后发起的请求占据缓存。"
    },
    {
      "id": "public/keys-are-independent",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "不同 key 的版本与缓存互相独立。"
    },
    {
      "id": "public/many-preserves-order-and-coalesces",
      "kind": "public",
      "group": "behavior",
      "summary": "多键顺序、重复合并与冻结",
      "weight": 1,
      "critical": true
    },
    {
      "id": "hidden/hit-returns-the-same-promise-without-reloading",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "hit returns the same promise without reloading"
    },
    {
      "id": "hidden/version-starts-at-zero-and-increments-per-invalidate",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "version starts at zero and increments per invalidate"
    },
    {
      "id": "hidden/stale-inflight-result-still-reaches-its-caller",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "stale inflight result still reaches its caller"
    },
    {
      "id": "hidden/only-the-last-generation-may-occupy-the-cache",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "only the last generation may occupy the cache"
    },
    {
      "id": "hidden/keys-are-independent-and-versions-do-not-leak",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "keys are independent and versions do not leak"
    },
    {
      "id": "hidden/failed-load-is-not-cached-and-can-be-retried",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "failed load is not cached and can be retried"
    },
    {
      "id": "hidden/multikey-retries-invalidated-cut",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "multikey retries invalidated cut"
    },
    {
      "id": "hidden/old-rejection-preserves-new-flight",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "old rejection preserves new flight"
    },
    {
      "id": "hidden/rejected-current-generation-is-retryable",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "rejected current generation is retryable"
    },
    {
      "id": "hidden/synchronous-source-error-is-a-rejection",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "synchronous source error is a rejection"
    },
    {
      "id": "hidden/new-success-survives-late-old-success",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "new success survives late old success"
    }
  ]
}
