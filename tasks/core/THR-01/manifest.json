{
  "schemaVersion": "0.1.0",
  "taskId": "THR-01",
  "taskVersion": "0.2.0",
  "title": "真实工作线程的分发与汇总",
  "runtime": "mixed",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/THR-01/checks",
    "referencePatch": "graders/THR-01/reference.patch",
    "alternative": "graders/THR-01/alternative",
    "defectDetectors": [
      "hidden/empty-input-rejects-invalid-size-too",
      "hidden/input-array-is-not-mutated",
      "hidden/large-batch-processes-every-job",
      "hidden/negative-payloads-do-not-affect-others",
      "hidden/observes-real-workers-and-exit",
      "hidden/rejects-invalid-size",
      "hidden/repeated-calls-do-not-leak-thread-ids",
      "hidden/reports-failed-jobs",
      "hidden/single-job-still-uses-a-worker-thread",
      "hidden/uses-real-worker-threads",
      "public/rejects-invalid-size",
      "public/reports-failed-jobs",
      "public/uses-real-worker-threads"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/computes-each-job",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "每个 job 的结果按 id 汇总。"
    },
    {
      "id": "public/uses-real-worker-threads",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "必须由真实 worker 线程处理，主线程 id 不得出现。"
    },
    {
      "id": "public/reports-failed-jobs",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "失败 job 进入 failures，不影响其它 job。"
    },
    {
      "id": "public/empty-input-creates-no-threads",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "空输入不创建线程。"
    },
    {
      "id": "public/rejects-invalid-size",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "非法 size 抛 RangeError。"
    },
    {
      "id": "hidden/computes-each-job",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "computes each job"
    },
    {
      "id": "hidden/uses-real-worker-threads",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "uses real worker threads"
    },
    {
      "id": "hidden/reports-failed-jobs",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "reports failed jobs"
    },
    {
      "id": "hidden/empty-input-creates-no-threads",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "empty input creates no threads"
    },
    {
      "id": "hidden/rejects-invalid-size",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "rejects invalid size"
    },
    {
      "id": "hidden/single-job-still-uses-a-worker-thread",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "single job still uses a worker thread"
    },
    {
      "id": "hidden/size-larger-than-jobs-caps-thread-count",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "size larger than jobs caps thread count"
    },
    {
      "id": "hidden/negative-payloads-do-not-affect-others",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "negative payloads do not affect others"
    },
    {
      "id": "hidden/empty-input-rejects-invalid-size-too",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "empty input rejects invalid size too"
    },
    {
      "id": "hidden/input-array-is-not-mutated",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "input array is not mutated"
    },
    {
      "id": "hidden/repeated-calls-do-not-leak-thread-ids",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "repeated calls do not leak thread ids"
    },
    {
      "id": "hidden/large-batch-processes-every-job",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "large batch processes every job"
    },
    {
      "id": "hidden/observes-real-workers-and-exit",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "observes real workers and exit"
    }
  ]
}
