      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "sync throw does not escape and clears timer"
    },
    {
      "id": "hidden/cancel-aborts-before-rejecting",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "cancel aborts before rejecting"
    },
    {
