{
  "schemaVersion": "0.1.0",
  "taskId": "CONC-01",
  "taskVersion": "0.2.0",
  "title": "取消与超时传播",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/CONC-01/checks",
    "referencePatch": "graders/CONC-01/reference.patch",
    "alternative": "graders/CONC-01/alternative",
    "defectDetectors": [
      "hidden/cancel-aborts-before-rejecting",
      "hidden/default-timeout-is-30000-and-explicit-zero-is-honored",
      "hidden/independent-tasks-do-not-share-timers-or-signals",
      "hidden/repeated-cancel-is-idempotent",
      "hidden/sync-throw-does-not-escape-and-clears-timer",
      "hidden/timeout-aborts-then-rejects-and-is-final",
      "hidden/timer-cancelled-exactly-once-on-every-outcome",
      "public/cancel-aborts-signal-and-rejects",
      "public/clears-timer-after-settle",
      "public/propagates-work-errors",
      "public/resolves-with-work-result",
      "public/timeout-rejects-and-aborts"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/resolves-with-work-result",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "工作成功时兑现结果并释放定时器。"
    },
    {
      "id": "public/cancel-aborts-signal-and-rejects",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "cancel 必须 abort signal 并以 CancelledError 拒绝。"
    },
    {
      "id": "public/timeout-rejects-and-aborts",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "超时必须 abort signal 并以 TimeoutError 拒绝。"
    },
    {
      "id": "public/clears-timer-after-settle",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "结算后不得留下存活定时器。"
    },
    {
      "id": "public/propagates-work-errors",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "工作抛错原样传播并释放定时器。"
    },
    {
      "id": "hidden/work-receives-fresh-non-aborted-signal",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "work receives fresh non aborted signal"
    },
    {
