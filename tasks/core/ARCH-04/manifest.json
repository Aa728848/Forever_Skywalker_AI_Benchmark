{
  "schemaVersion": "0.1.0",
  "taskId": "ARCH-04",
  "taskVersion": "0.3.0",
  "title": "插件热切换、失败回滚与资源归属",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/ARCH-04/checks",
    "referencePatch": "graders/ARCH-04/reference.patch",
    "alternative": "graders/ARCH-04/alternative",
    "defectDetectors": [
      "hidden/committed-plugin-survives-previous-cleanup-error",
      "hidden/each-plugin-is-torn-down-at-most-once",
      "hidden/failed-setup-rolls-back-new-and-keeps-old",
      "hidden/reentrant-dispose-joins-unpublished-setup",
      "hidden/reentrant-new-selection-is-visible-before-publication",
      "hidden/released-is-snapshot-and-rollback-then-retry-succeeds",
      "hidden/same-active-selection-cancels-pending-intent",
      "hidden/seeded-completion-order-has-one-owner",
      "hidden/success-order-is-setup-then-commit-then-teardown",
      "hidden/switch-to-same-id-is-a-complete-noop",
      "public/async-activation-rollback-owns-partial-resources",
      "public/cleanup-lifo-continues-after-failure",
      "public/failed-switch-keeps-previous-plugin",
      "public/failed-switch-releases-new-plugin",
      "public/latest-intent-fences-out-of-order-setup",
      "public/scope-closes-registration-after-setup"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/switch-succeeds-and-releases-previous",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "成功切换并释放旧插件。"
    },
    {
      "id": "public/failed-switch-keeps-previous-plugin",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "切换失败后旧插件必须仍然生效且不被 teardown。"
    },
    {
      "id": "public/failed-switch-releases-new-plugin",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "失败的新插件必须释放它占用的资源。"
    },
    {
      "id": "public/teardown-happens-once-per-plugin",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "每个插件最多 teardown 一次。"
    },
    {
      "id": "public/switch-to-same-plugin-is-noop",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "切换到同一个插件是空操作。"
    },
    {
      "id": "public/async-activation-rollback-owns-partial-resources",
      "kind": "public",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "启动失败回收部分资源，旧确认插件继续服务。"
    },
    {
      "id": "public/latest-intent-fences-out-of-order-setup",
      "kind": "public",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "慢启动不得覆盖新选择，旧候选signal中止并释放。"
    },
    {
      "id": "public/cleanup-lifo-continues-after-failure",
      "kind": "public",
      "group": "resources",
      "weight": 2,
      "critical": true,
      "summary": "异步逆序清理，即使一个失败也释放其余所有资源。"
    },
    {
      "id": "public/scope-closes-registration-after-setup",
      "kind": "public",
      "group": "boundary",
      "weight": 2,
      "critical": true,
      "summary": "已结束启动的作用域和关闭宿主拒绝新增资源。"
    },
    {
      "id": "hidden/reentrant-dispose-joins-unpublished-setup",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "reentrant dispose joins unpublished setup"
    },
    {
      "id": "hidden/reentrant-new-selection-is-visible-before-publication",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "reentrant new selection is visible before publication"
    },
    {
      "id": "hidden/same-active-selection-cancels-pending-intent",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "same active selection cancels pending intent"
    },
    {
      "id": "hidden/committed-plugin-survives-previous-cleanup-error",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "committed plugin survives previous cleanup error"
    },
    {
      "id": "hidden/seeded-completion-order-has-one-owner",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "seeded completion order has one owner"
    },
    {
      "id": "hidden/success-order-is-setup-then-commit-then-teardown",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "success order is setup then commit then teardown"
    },
    {
      "id": "hidden/failed-setup-rolls-back-new-and-keeps-old",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "failed setup rolls back new and keeps old"
    },
    {
      "id": "hidden/each-plugin-is-torn-down-at-most-once",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "each plugin is torn down at most once"
    },
    {
      "id": "hidden/switch-to-same-id-is-a-complete-noop",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "switch to same id is a complete noop"
    },
    {
      "id": "hidden/released-is-snapshot-and-rollback-then-retry-succeeds",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "released is snapshot and rollback then retry succeeds"
    }
  ]
}
