{
  "schemaVersion": "0.1.0",
  "taskId": "BND-04",
  "taskVersion": "0.1.1",
  "title": "超深、超大和畸形输入的有界解析",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=process",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=process",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/BND-04/checks",
    "referencePatch": "graders/BND-04/reference.patch",
    "alternative": "graders/BND-04/alternative",
    "defectDetectors": [
      "public/depth-budget",
      "public/boundary-utf8-budget",
      "hidden/nodes-before-materialization",
      "hidden/boundary-invalid-input",
      "hidden/state-rejection-does-not-leak"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/depth-budget",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "public/depth-budget"
    },
    {
      "id": "public/boundary-utf8-budget",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "public/boundary-utf8-budget"
    },
    {
      "id": "public/escaped-strings",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "public/escaped-strings"
    },
    {
      "id": "hidden/nodes-before-materialization",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "hidden/nodes-before-materialization"
    },
    {
      "id": "hidden/resource-deep-stack-safe",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "hidden/resource-deep-stack-safe"
    },
    {
      "id": "hidden/boundary-invalid-input",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "hidden/boundary-invalid-input"
    },
    {
      "id": "hidden/differential-budget-boundary",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": true,
      "summary": "hidden/differential-budget-boundary"
    },
    {
      "id": "hidden/state-rejection-does-not-leak",
      "kind": "hidden",
      "group": "state",
      "summary": "预算与语法失败不污染后续正常解析状态。",
      "weight": 1,
      "critical": true
    }
  ]
}
