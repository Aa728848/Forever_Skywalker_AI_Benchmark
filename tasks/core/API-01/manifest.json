{
  "schemaVersion": "0.1.0",
  "taskId": "API-01",
  "taskVersion": "0.3.0",
  "title": "请求校验与错误契约",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/API-01/checks",
    "referencePatch": "graders/API-01/reference.patch",
    "alternative": "graders/API-01/alternative",
    "defectDetectors": [
      "hidden/independent-combinations-and-stable-order",
      "hidden/issue-order-is-stable-and-complete",
      "hidden/non-plain-payloads-rejected",
      "hidden/note-optional-but-when-present-strict",
      "hidden/plain-object-boundary",
      "hidden/quantity-must-be-integer-in-1-to-1000",
      "hidden/result-is-frozen-and-detached",
      "hidden/unknown-fields-including-prototype-names",
      "public/collects-every-issue",
      "public/quantity-range-boundaries",
      "public/rejects-numeric-strings",
      "public/rejects-unknown-fields",
      "public/returns-frozen-copy"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/accepts-valid-request",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "合法请求原样通过并保留 note。"
    },
    {
      "id": "public/reports-missing-fields",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "缺失必填字段逐项报 missing。"
    },
    {
      "id": "public/rejects-numeric-strings",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "数字字符串不得被隐式转换。"
    },
    {
      "id": "public/quantity-range-boundaries",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "数量边界 1 与 1000 合法，越界与小数报错。"
    },
    {
      "id": "public/rejects-unknown-fields",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "未知字段严格拒绝。"
    },
    {
      "id": "public/collects-every-issue",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "一次返回全部问题且顺序稳定。"
    },
    {
      "id": "public/rejects-non-object-payload",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "非对象载荷直接报 type。"
    },
    {
      "id": "public/returns-frozen-copy",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "返回冻结副本，不受调用方后续修改影响。"
    },
    {
      "id": "hidden/plain-object-boundary",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "plain object boundary"
    },
    {
      "id": "hidden/independent-combinations-and-stable-order",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "independent combinations and stable order"
    },
    {
      "id": "hidden/quantity-must-be-integer-in-1-to-1000",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "quantity must be integer in 1 to 1000"
    },
    {
      "id": "hidden/order-id-must-be-non-empty-string",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "order id must be non empty string"
    },
    {
      "id": "hidden/note-optional-but-when-present-strict",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "note optional but when present strict"
    },
    {
      "id": "hidden/issue-order-is-stable-and-complete",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "issue order is stable and complete"
    },
    {
      "id": "hidden/unknown-fields-including-prototype-names",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "unknown fields including prototype names"
    },
    {
      "id": "hidden/non-plain-payloads-rejected",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "non plain payloads rejected"
    },
    {
      "id": "hidden/result-is-frozen-and-detached",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "result is frozen and detached"
    },
    {
      "id": "hidden/error-shape-and-message-are-stable",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "error shape and message are stable"
    }
  ]
}
