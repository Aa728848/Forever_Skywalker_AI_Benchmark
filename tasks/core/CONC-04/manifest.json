{
  "schemaVersion": "0.1.0",
  "taskId": "CONC-04",
  "taskVersion": "0.1.0",
  "title": "断点续跑、重复事件和副作用去重",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/CONC-04/checks",
    "referencePatch": "graders/CONC-04/reference.patch",
    "alternative": "graders/CONC-04/alternative",
    "defectDetectors": [
      "public/duplicate-event-ids-are-skipped",
      "public/late-events-are-ignored",
      "public/effects-are-applied-once-per-id",
      "hidden/crash-after-effect-does-not-double-apply",
      "hidden/resume-drains-pending-effects",
      "hidden/effect-ledger-is-the-authority",
      "hidden/out-of-order-and-duplicate-mix"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/applies-batch-in-seq-order",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "按 (seq, id) 升序处理一批事件。"
    },
    {
      "id": "public/duplicate-event-ids-are-skipped",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "同一事件 id 只生效一次。"
    },
    {
      "id": "public/late-events-are-ignored",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "迟到事件不覆盖已推进的状态。"
    },
    {
      "id": "public/effects-are-applied-once-per-id",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "重复处理不重复执行副作用。"
    },
    {
      "id": "public/state-is-persisted",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "状态只来自存储，新实例可恢复。"
    },
    {
      "id": "public/empty-batch-is-a-no-op",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "空批次不改变状态也不产生副作用。"
    },
    {
      "id": "hidden/crash-after-effect-does-not-double-apply",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "副作用之后崩溃，恢复后副作用恰好一次。"
    },
    {
      "id": "hidden/resume-drains-pending-effects",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "检查点之后、副作用之前崩溃，恢复会补做且只做一次。"
    },
    {
      "id": "hidden/effect-ledger-is-the-authority",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "账本已记录的副作用不得再次执行。"
    },
    {
      "id": "hidden/out-of-order-and-duplicate-mix",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "乱序、重复与迟到混合批次的结果正确。"
    },
    {
      "id": "hidden/new-runner-reads-state-from-store",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "构造只读存储，不依赖内存残留。"
    }
  ]
}
