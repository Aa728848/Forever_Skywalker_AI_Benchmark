{
  "schemaVersion": "0.1.0",
  "taskId": "LIFE-02",
  "taskVersion": "0.3.0",
  "title": "流结束、超时和迟到回调",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/LIFE-02/checks",
    "referencePatch": "graders/LIFE-02/reference.patch",
    "alternative": "graders/LIFE-02/alternative",
    "defectDetectors": [
      "hidden/cancel-freezes-and-reclaims-both-resources",
      "hidden/end-and-timeout-do-not-cross-contaminate",
      "hidden/first-terminal-wins-across-all-three",
      "hidden/ignores-events-after-end",
      "hidden/ignores-events-after-error",
      "hidden/source-start-failure-releases-deadline",
      "hidden/synchronous-deadline-does-not-open-source",
      "hidden/timeout-freezes-stream",
      "public/ignores-events-after-end",
      "public/ignores-events-after-error",
      "public/synchronous-end-releases-late-subscription-handle",
      "public/timeout-freezes-stream"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/collects-data-until-end",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "正常收集到 end。"
    },
    {
      "id": "public/ignores-events-after-end",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "结束后到达的事件一律忽略。"
    },
    {
      "id": "public/ignores-events-after-error",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "出错后保留第一条错误并忽略后续。"
    },
    {
      "id": "public/timeout-freezes-stream",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "超时冻结流且幂等。"
    },
    {
      "id": "public/summary-is-a-snapshot",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "summary 是快照。"
    },
    {
      "id": "public/synchronous-end-releases-late-subscription-handle",
      "kind": "public",
      "group": "resources",
      "weight": 2,
      "critical": true,
      "summary": "subscribe同步结束后才返回句柄，也必须被释放且取消deadline。"
    },
    {
      "id": "hidden/cancel-freezes-and-reclaims-both-resources",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "cancel freezes and reclaims both resources"
    },
    {
      "id": "hidden/synchronous-deadline-does-not-open-source",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "synchronous deadline does not open source"
    },
    {
      "id": "hidden/source-start-failure-releases-deadline",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "source start failure releases deadline"
    },
    {
      "id": "hidden/collects-data-until-end",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "collects data until end"
    },
    {
      "id": "hidden/ignores-events-after-end",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "ignores events after end"
    },
    {
      "id": "hidden/ignores-events-after-error",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "ignores events after error"
    },
    {
      "id": "hidden/timeout-freezes-stream",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "timeout freezes stream"
    },
    {
      "id": "hidden/summary-is-a-snapshot",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "summary is a snapshot"
    },
    {
      "id": "hidden/first-terminal-wins-across-all-three",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "first terminal wins across all three"
    },
    {
      "id": "hidden/timeout-ms-defaults-and-is-readable",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "timeout ms defaults and is readable"
    },
    {
      "id": "hidden/end-and-timeout-do-not-cross-contaminate",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "end and timeout do not cross contaminate"
    }
  ]
}
