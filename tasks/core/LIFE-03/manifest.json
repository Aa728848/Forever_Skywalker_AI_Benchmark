{
  "schemaVersion": "0.1.0",
  "taskId": "LIFE-03",
  "taskVersion": "0.2.0",
  "title": "启动、停止和重启竞争",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/LIFE-03/checks",
    "referencePatch": "graders/LIFE-03/reference.patch",
    "alternative": "graders/LIFE-03/alternative",
    "defectDetectors": [
      "hidden/start-during-stop-waits-and-uses-fresh-signal",
      "hidden/stop-then-start-restarts-cleanly",
      "public/start-during-stop-waits-and-uses-fresh-signal",
      "public/stop-then-start-restarts-cleanly",
      "public/natural-completion-releases-generation",
      "public/synchronous-runner-failure-is-retryable",
      "hidden/concurrent-restarts-join-one-stopping-generation",
      "hidden/async-runner-rejection-releases-resources",
      "hidden/seeded-natural-and-controlled-stops-remain-independent"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/starts-and-stops",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "启动与停止的基本语义与 phase。"
    },
    {
      "id": "public/repeated-start-is-idempotent",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "重复 start 不重复调用 runner。"
    },
    {
      "id": "public/start-during-stop-waits-and-uses-fresh-signal",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "停止期间的重启必须等待并拿到全新 signal。"
    },
    {
      "id": "public/stop-is-idempotent",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "重复 stop 幂等。"
    },
    {
      "id": "public/stop-then-start-restarts-cleanly",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "停止后重新启动干净可用。"
    },
    {
      "id": "hidden/starts-and-stops",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的启停。"
    },
    {
      "id": "hidden/repeated-start-is-idempotent",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的幂等启动。"
    },
    {
      "id": "hidden/start-during-stop-waits-and-uses-fresh-signal",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的重启竞争。"
    },
    {
      "id": "hidden/stop-is-idempotent",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的幂等停止。"
    },
    {
      "id": "hidden/stop-then-start-restarts-cleanly",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的停止后重启。"
    },
    {
      "id": "public/natural-completion-releases-generation",
      "kind": "public",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "runner自然结束回到idle，后续启动使用独立未中止signal。"
    },
    {
      "id": "public/synchronous-runner-failure-is-retryable",
      "kind": "public",
      "group": "boundary",
      "weight": 2,
      "critical": true,
      "summary": "同步启动异常以原错误拒绝并释放启动状态。"
    },
    {
      "id": "hidden/concurrent-restarts-join-one-stopping-generation",
      "kind": "hidden",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "停止屏障未完成时多个start等待且合并为一次新启动。"
    },
    {
      "id": "hidden/async-runner-rejection-releases-resources",
      "kind": "hidden",
      "group": "resources",
      "weight": 2,
      "critical": true,
      "summary": "后台运行拒绝后结束生命周期，不保留已死运行实例阻塞重启。"
    },
    {
      "id": "hidden/seeded-natural-and-controlled-stops-remain-independent",
      "kind": "hidden",
      "group": "regression",
      "weight": 2,
      "critical": true,
      "summary": "混合自然退出与控制停止的固定序列验证代际不会复用。"
    }
  ]
}
