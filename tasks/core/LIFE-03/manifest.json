{
  "schemaVersion": "0.1.0",
  "taskId": "LIFE-03",
  "taskVersion": "0.3.0",
  "title": "启动、停止和重启竞争",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/LIFE-03/checks",
    "referencePatch": "graders/LIFE-03/reference.patch",
    "alternative": "graders/LIFE-03/alternative",
    "defectDetectors": [
      "hidden/async-runner-rejection-releases-resources",
      "hidden/concurrent-restarts-join-one-stopping-generation",
      "hidden/multiple-starts-during-stop-merge-into-one",
      "hidden/old-generation-settlement-cannot-clear-new-state",
      "hidden/seeded-natural-and-controlled-stops-remain-independent",
      "hidden/start-while-stopping-defers-and-is-not-dropped",
      "hidden/sync-throwing-runner-rejects-start-and-returns-to-idle",
      "public/natural-completion-releases-generation",
      "public/start-during-stop-waits-and-uses-fresh-signal",
      "public/stop-then-start-restarts-cleanly",
      "public/synchronous-runner-failure-is-retryable"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/starts-and-stops",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "启动与停止的基本语义与 phase。"
    },
    {
      "id": "public/repeated-start-is-idempotent",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "重复 start 不重复调用 runner。"
    },
    {
      "id": "public/start-during-stop-waits-and-uses-fresh-signal",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "停止期间的重启必须等待并拿到全新 signal。"
    },
    {
      "id": "public/stop-is-idempotent",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "重复 stop 幂等。"
    },
    {
      "id": "public/stop-then-start-restarts-cleanly",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "停止后重新启动干净可用。"
    },
    {
      "id": "public/natural-completion-releases-generation",
      "kind": "public",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "runner自然结束回到idle，后续启动使用独立未中止signal。"
    },
    {
      "id": "public/synchronous-runner-failure-is-retryable",
      "kind": "public",
      "group": "boundary",
      "weight": 2,
      "critical": true,
      "summary": "同步启动异常以原错误拒绝并释放启动状态。"
    },
    {
      "id": "hidden/concurrent-restarts-join-one-stopping-generation",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
