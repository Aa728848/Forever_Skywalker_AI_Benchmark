{
  "schemaVersion": "0.1.0",
  "taskId": "PERF-01",
  "taskVersion": "0.3.0",
  "title": "消除重复解析并保持结果",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/PERF-01/checks",
    "referencePatch": "graders/PERF-01/reference.patch",
    "alternative": "graders/PERF-01/alternative",
    "defectDetectors": [
      "hidden/access-count-stays-linear",
      "hidden/matches-a-naive-single-pass-reference",
      "hidden/prototype-keys-are-data",
      "public/input-accesses-are-linear"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/parses-and-sums",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "解析合法行并按 key 累加，空输入返回空对象。"
    },
    {
      "id": "public/rejects-invalid-lines",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "非法行抛 InvalidLineError，index 指到具体行。"
    },
    {
      "id": "public/matches-naive-reference",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "与朴素差分参考结果一致。"
    },
    {
      "id": "public/input-accesses-are-linear",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "对输入的元素访问次数必须是 O(n)。"
    },
    {
      "id": "public/duplicate-heavy-input-is-linear",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "重复行密集的输入同样保持线性。"
    },
    {
      "id": "hidden/prototype-keys-are-data",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "prototype keys are data"
    },
    {
      "id": "hidden/seeded-independent-totals-and-invalid-index",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "seeded independent totals and invalid index"
    },
    {
      "id": "hidden/access-count-stays-linear",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "access count stays linear"
    },
    {
      "id": "hidden/duplicate-lines-do-not-inflate-access-count",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "duplicate lines do not inflate access count"
    },
    {
      "id": "hidden/empty-and-single-line-inputs",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "empty and single line inputs"
    },
    {
      "id": "hidden/parse-line-accepts-and-rejects-exactly",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "parse line accepts and rejects exactly"
    },
    {
      "id": "hidden/summarize-reports-the-offending-line-index",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "summarize reports the offending line index"
    },
    {
      "id": "hidden/input-is-never-mutated-and-calls-are-repeatable",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "input is never mutated and calls are repeatable"
    },
    {
      "id": "hidden/matches-a-naive-single-pass-reference",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "matches a naive single pass reference"
    }
  ]
}
