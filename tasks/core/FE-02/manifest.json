{
  "schemaVersion": "0.1.0",
  "taskId": "FE-02",
  "taskVersion": "0.1.0",
  "title": "异步请求乱序与取消",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/FE-02/checks",
    "referencePatch": "graders/FE-02/reference.patch",
    "alternative": "graders/FE-02/alternative",
    "defectDetectors": [
      "hidden/cancel-all-rejects-and-aborts",
      "hidden/different-keys-are-independent",
      "hidden/keeps-newest-result-even-out-of-order",
      "hidden/settles-pending-on-failure",
      "hidden/supersedes-previous-request",
      "public/cancel-all-rejects-and-aborts",
      "public/different-keys-are-independent",
      "public/keeps-newest-result-even-out-of-order",
      "public/settles-pending-on-failure",
      "public/supersedes-previous-request"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/supersedes-previous-request",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "同 key 新请求取代旧请求并 abort 旧 signal。"
    },
    {
      "id": "public/keeps-newest-result-even-out-of-order",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "乱序返回时只兑现最新请求。"
    },
    {
      "id": "public/different-keys-are-independent",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "不同 key 互不影响。"
    },
    {
      "id": "public/settles-pending-on-failure",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "端口失败也把 pending 归零。"
    },
    {
      "id": "public/cancel-all-rejects-and-aborts",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "cancelAll 中止并拒绝全部挂起请求。"
    },
    {
      "id": "hidden/supersedes-previous-request",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的取代语义。"
    },
    {
      "id": "hidden/keeps-newest-result-even-out-of-order",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的乱序结算。"
    },
    {
      "id": "hidden/different-keys-are-independent",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的多 key 独立。"
    },
    {
      "id": "hidden/settles-pending-on-failure",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的失败清理。"
    },
    {
      "id": "hidden/cancel-all-rejects-and-aborts",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的取消语义。"
    }
  ]
}
