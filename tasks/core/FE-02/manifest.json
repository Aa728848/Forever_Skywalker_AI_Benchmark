{
  "schemaVersion": "0.1.0",
  "taskId": "FE-02",
  "taskVersion": "0.3.0",
  "title": "异步请求乱序与取消",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/FE-02/checks",
    "referencePatch": "graders/FE-02/reference.patch",
    "alternative": "graders/FE-02/alternative",
    "defectDetectors": [
      "hidden/cancelAll-aborts-everything-with-superseded-error",
      "hidden/late-settlements-after-cancelAll-are-ignored",
      "hidden/pending-returns-to-zero-on-every-outcome",
      "hidden/port-error-does-not-poison-later-requests",
      "hidden/signals-are-distinct-per-request-and-never-shared",
      "hidden/stale-result-can-never-resolve-old-promise",
      "hidden/supersede-aborts-old-signal-then-rejects",
      "hidden/three-keys-interleave-without-cross-talk",
      "hidden/three-rounds-of-supersede-keep-exactly-one-live",
      "public/cancel-all-rejects-and-aborts",
      "public/different-keys-are-independent",
      "public/keeps-newest-result-even-out-of-order",
      "public/settles-pending-on-failure",
      "public/supersedes-previous-request"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/supersedes-previous-request",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "同 key 新请求取代旧请求并 abort 旧 signal。"
    },
    {
      "id": "public/keeps-newest-result-even-out-of-order",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "乱序返回时只兑现最新请求。"
    },
    {
      "id": "public/different-keys-are-independent",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "不同 key 互不影响。"
    },
    {
      "id": "public/settles-pending-on-failure",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "端口失败也把 pending 归零。"
    },
    {
      "id": "public/cancel-all-rejects-and-aborts",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "cancelAll 中止并拒绝全部挂起请求。"
    },
    {
      "id": "hidden/supersede-aborts-old-signal-then-rejects",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "supersede aborts old signal then rejects"
    },
    {
      "id": "hidden/stale-result-can-never-resolve-old-promise",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "stale result can never resolve old promise"
    },
    {
      "id": "hidden/pending-returns-to-zero-on-every-outcome",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "pending returns to zero on every outcome"
    },
    {
      "id": "hidden/port-error-does-not-poison-later-requests",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "port error does not poison later requests"
    },
    {
      "id": "hidden/cancelAll-aborts-everything-with-superseded-error",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "cancelAll aborts everything with superseded error"
    },
    {
      "id": "hidden/late-settlements-after-cancelAll-are-ignored",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "late settlements after cancelAll are ignored"
    },
    {
      "id": "hidden/three-rounds-of-supersede-keep-exactly-one-live",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "three rounds of supersede keep exactly one live"
    },
    {
      "id": "hidden/signals-are-distinct-per-request-and-never-shared",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "signals are distinct per request and never shared"
    },
    {
      "id": "hidden/three-keys-interleave-without-cross-talk",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "three keys interleave without cross talk"
    }
  ]
}
