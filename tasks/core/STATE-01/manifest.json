{
  "schemaVersion": "0.1.0",
  "taskId": "STATE-01",
  "taskVersion": "0.2.0",
  "title": "原子写入与损坏检测",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/STATE-01/checks",
    "referencePatch": "graders/STATE-01/reference.patch",
    "alternative": "graders/STATE-01/alternative",
    "defectDetectors": [
      "hidden/closed-store-rejects-operations",
      "hidden/detects-tampered-checksum",
      "hidden/empty-value-round-trips",
      "public/closed-store-rejects-operations",
      "public/detects-tampered-checksum",
      "public/empty-value-round-trips",
      "hidden/invalid-json-shapes-use-domain-error",
      "hidden/rename-failure-preserves-record-and-cleans-staging"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/round-trips-values",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "多字节与换行内容往返一致。"
    },
    {
      "id": "public/detects-tampered-checksum",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "内容被篡改或文件不是合法记录时抛 CorruptRecordError。"
    },
    {
      "id": "public/empty-value-round-trips",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "空字符串是合法值。"
    },
    {
      "id": "public/missing-key-and-invalid-key",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "缺失键返回 null，非法键抛 RangeError。"
    },
    {
      "id": "public/atomic-write-leaves-no-temp-files",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "原子替换后目录里没有临时残留。"
    },
    {
      "id": "public/closed-store-rejects-operations",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "关闭后读写抛 StoreClosedError。"
    },
    {
      "id": "hidden/round-trips-values",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的往返。"
    },
    {
      "id": "hidden/detects-tampered-checksum",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的损坏检测。"
    },
    {
      "id": "hidden/empty-value-round-trips",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "空白字符串也按字面保存。"
    },
    {
      "id": "hidden/missing-key-and-invalid-key",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的键语义。"
    },
    {
      "id": "hidden/atomic-write-leaves-no-temp-files",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "多键写入后没有临时残留。"
    },
    {
      "id": "hidden/closed-store-rejects-operations",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的关闭语义。"
    },
    {
      "id": "hidden/invalid-json-shapes-use-domain-error",
      "kind": "hidden",
      "group": "boundary",
      "weight": 2,
      "critical": true,
      "summary": "合法JSON的null、数组与标量也必须用领域错误拒绝。"
    },
    {
      "id": "hidden/rename-failure-preserves-record-and-cleans-staging",
      "kind": "hidden",
      "group": "resources",
      "weight": 2,
      "critical": true,
      "summary": "注入真实fs.renameSync失败，旧正式记录保持完整且暂存文件释放。"
    }
  ]
}
