{
  "schemaVersion": "0.1.0",
  "taskId": "STATE-01",
  "taskVersion": "0.3.0",
  "title": "原子写入与损坏检测",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/STATE-01/checks",
    "referencePatch": "graders/STATE-01/reference.patch",
    "alternative": "graders/STATE-01/alternative",
    "defectDetectors": [
      "hidden/checksum-must-match-exact-bytes",
      "hidden/close-is-idempotent-and-final",
      "hidden/empty-string-is-a-value-not-a-missing-key",
      "hidden/invalid-json-shapes-use-domain-error",
      "hidden/many-keys-stay-independent",
      "hidden/missing-file-and-zero-byte-file-differ",
      "hidden/overwrite-keeps-only-the-latest-record",
      "hidden/rename-failure-preserves-record-and-cleans-staging",
      "public/closed-store-rejects-operations",
      "public/detects-tampered-checksum",
      "public/empty-value-round-trips"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/round-trips-values",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "多字节与换行内容往返一致。"
    },
    {
      "id": "public/detects-tampered-checksum",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "内容被篡改或文件不是合法记录时抛 CorruptRecordError。"
    },
    {
      "id": "public/empty-value-round-trips",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "空字符串是合法值。"
    },
    {
      "id": "public/missing-key-and-invalid-key",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "缺失键返回 null，非法键抛 RangeError。"
    },
    {
      "id": "public/atomic-write-leaves-no-temp-files",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "原子替换后目录里没有临时残留。"
    },
    {
      "id": "public/closed-store-rejects-operations",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "关闭后读写抛 StoreClosedError。"
    },
    {
      "id": "hidden/invalid-json-shapes-use-domain-error",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "invalid json shapes use domain error"
    },
    {
      "id": "hidden/rename-failure-preserves-record-and-cleans-staging",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "rename failure preserves record and cleans staging"
    },
    {
      "id": "hidden/empty-string-is-a-value-not-a-missing-key",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "empty string is a value not a missing key"
    },
    {
      "id": "hidden/checksum-must-match-exact-bytes",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "checksum must match exact bytes"
    },
    {
      "id": "hidden/overwrite-keeps-only-the-latest-record",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "overwrite keeps only the latest record"
    },
    {
      "id": "hidden/unicode-and-multiline-round-trip-exactly",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "unicode and multiline round trip exactly"
    },
    {
      "id": "hidden/invalid-keys-never-escape-the-directory",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "invalid keys never escape the directory"
    },
    {
      "id": "hidden/close-is-idempotent-and-final",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "close is idempotent and final"
    },
    {
      "id": "hidden/many-keys-stay-independent",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "many keys stay independent"
    },
    {
      "id": "hidden/missing-file-and-zero-byte-file-differ",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "missing file and zero byte file differ"
    }
  ]
}
