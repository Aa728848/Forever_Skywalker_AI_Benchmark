{
  "schemaVersion": "0.1.0",
  "taskId": "LSP-03",
  "taskVersion": "0.2.0",
  "title": "取消和过期诊断隔离",
  "runtime": "fsharp",
  "runtimeRange": "dotnet >= 10.0",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "dotnet",
      "fsi",
      "public-tests/checks.fsx"
    ],
    "hidden": [
      "dotnet",
      "fsi",
      "__checks__/checks.fsx"
    ]
  },
  "grader": {
    "checks": "graders/LSP-03/checks",
    "referencePatch": "graders/LSP-03/reference.patch",
    "alternative": "graders/LSP-03/alternative",
    "defectDetectors": [
      "public/cancel-and-stale-result",
      "public/state-close-reopen",
      "hidden/independent-documents",
      "hidden/state-once-and-published-retained",
      "hidden/cancellation-callback-lock-boundary",
      "hidden/reentrant-close-and-reopen",
      "hidden/foreign-request-identity",
      "hidden/callback-failure-commits-retirement"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/cancel-and-stale-result",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "public/cancel-and-stale-result"
    },
    {
      "id": "public/state-close-reopen",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "public/state-close-reopen"
    },
    {
      "id": "public/version-rejection",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "public/version-rejection"
    },
    {
      "id": "hidden/independent-documents",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": true,
      "summary": "hidden/independent-documents"
    },
    {
      "id": "hidden/state-once-and-published-retained",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "hidden/state-once-and-published-retained"
    },
    {
      "id": "hidden/resource-parallel-publication",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "hidden/resource-parallel-publication"
    },
    {
      "id": "hidden/cancellation-callback-lock-boundary",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "取消回调不持内部锁，另一线程可观察状态。"
    },
    {
      "id": "hidden/reentrant-close-and-reopen",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "关闭先撤销旧代，回调可重开低版本。"
    },
    {
      "id": "hidden/foreign-request-identity",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "不同协调器的同号请求不能相互发布。"
    },
    {
      "id": "hidden/callback-failure-commits-retirement",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": true,
      "summary": "回调抛错仍提交退休状态并允许恢复。"
    }
  ]
}
