{
  "schemaVersion": "0.1.0",
  "taskId": "FE-01",
  "taskVersion": "0.2.0",
  "title": "状态与错误恢复",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/FE-01/checks",
    "referencePatch": "graders/FE-01/reference.patch",
    "alternative": "graders/FE-01/alternative",
    "defectDetectors": [
      "public/deduplicates-overlapping-pages",
      "public/failure-is-surfaced-and-recoverable",
      "public/failure-keeps-items-and-cursor",
      "hidden/error-cleared-on-success",
      "hidden/large-pages-stay-unique",
      "hidden/retry-after-partial-overlap-has-unique-ids"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/initial-state-is-empty",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "构造后为空闲的空列表。"
    },
    {
      "id": "public/appends-page-and-advances-cursor",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "成功加载追加条目并推进游标。"
    },
    {
      "id": "public/deduplicates-overlapping-pages",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "分页重叠时按 id 去重。"
    },
    {
      "id": "public/failure-is-surfaced-and-recoverable",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "失败暴露错误并恢复 busy，重试可成功。"
    },
    {
      "id": "public/failure-keeps-items-and-cursor",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "失败不改变条目与游标，重试仍取同一页。"
    },
    {
      "id": "public/busy-blocks-concurrent-loads",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "busy 期间不再发起加载。"
    },
    {
      "id": "public/render-receives-snapshot",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "视图收到快照，调用方修改副本不影响状态。"
    },
    {
      "id": "hidden/retry-after-partial-overlap-has-unique-ids",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "失败重试且分页重叠时 id 仍唯一。"
    },
    {
      "id": "hidden/view-callback-sequence",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "成功路径的视图回调序列。"
    },
    {
      "id": "hidden/error-cleared-on-success",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "重试成功后错误被清空并通知视图。"
    },
    {
      "id": "hidden/empty-page-keeps-cursor",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "空页不推进游标。"
    },
    {
      "id": "hidden/two-controllers-are-independent",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "实例之间没有共享状态。"
    },
    {
      "id": "hidden/large-pages-stay-unique",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "大页重叠去重后条目数正确。"
    }
  ]
}
