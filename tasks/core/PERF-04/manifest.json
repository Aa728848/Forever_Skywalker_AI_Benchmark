{
  "schemaVersion": "0.1.0",
  "taskId": "PERF-04",
  "taskVersion": "0.3.0",
  "title": "长会话重放的延迟、吞吐与内存预算",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/PERF-04/checks",
    "referencePatch": "graders/PERF-04/reference.patch",
    "alternative": "graders/PERF-04/alternative",
    "defectDetectors": [
      "public/input-accesses-are-linear",
      "hidden/scaling-ratio-is-subquadratic",
      "public/projection-persist-failure-is-not-visible",
      "hidden/projection-isolation-until-persist-ack",
      "hidden/projection-rejects-stale-and-forged-tickets",
      "hidden/projection-checkpoint-log-identity-and-aliases",
      "hidden/projection-backpressure-and-iterator-close"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/counts-sessions-and-messages",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "会话数与消息数与朴素参考一致。"
    },
    {
      "id": "public/bytes-counts-utf8",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "payload 按 UTF-8 字节计数。"
    },
    {
      "id": "public/last-at-and-empty-input",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "空输入与乱序 at 的边界语义。"
    },
    {
      "id": "public/longest-session-tie-break",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "并列时取字典序最小的会话 id。"
    },
    {
      "id": "public/matches-naive-reference",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "多组固定种子输入与差分参考完全一致。"
    },
    {
      "id": "public/input-accesses-are-linear",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "对输入的元素访问次数必须是 O(n)。"
    },
    {
      "id": "hidden/scaling-ratio-is-subquadratic",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "4 倍规模下访问次数比值必须亚二次。"
    },
    {
      "id": "hidden/unique-sessions-per-event",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "每个事件独立会话时的统计正确。"
    },
    {
      "id": "hidden/default-session-is-empty-string",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "缺省 session 按空串聚合。"
    },
    {
      "id": "hidden/does-not-mutate-input",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "重复重放结果一致且不修改输入。"
    },
    {
      "id": "hidden/timing-samples-are-bounded",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "记录原始耗时样本并守住宽松上限。"
    },
    {
      "id": "public/projection-replay-checkpoint-resume",
      "kind": "public",
      "group": "behavior",
      "summary": "流式UTF8投影检查点恢复且不重计",
      "weight": 1,
      "critical": true
    },
    {
      "id": "public/projection-persist-failure-is-not-visible",
      "kind": "public",
      "group": "state",
      "summary": "持久失败不发布且同票据可重试",
      "weight": 1,
      "critical": true
    },
    {
      "id": "hidden/projection-isolation-until-persist-ack",
      "kind": "hidden",
      "group": "state",
      "summary": "持久确认前保留旧切面",
      "weight": 1,
      "critical": true
    },
    {
      "id": "hidden/projection-rejects-stale-and-forged-tickets",
      "kind": "hidden",
      "group": "state",
      "summary": "并行旧代与伪造票据拒绝",
      "weight": 1,
      "critical": true
    },
    {
      "id": "hidden/projection-checkpoint-log-identity-and-aliases",
      "kind": "hidden",
      "group": "boundary",
      "summary": "检查点日志身份及输入隔离",
      "weight": 1,
      "critical": true
    },
    {
      "id": "hidden/projection-backpressure-and-iterator-close",
      "kind": "hidden",
      "group": "resources",
      "summary": "流式背压与异常迭代器关闭",
      "weight": 1,
      "critical": true
    },
    {
      "id": "hidden/projection-lifecycle-and-failed-batch-atomicity",
      "kind": "hidden",
      "group": "boundary",
      "summary": "生命周期、整批失败与纯重放",
      "weight": 1,
      "critical": true
    },
    {
      "id": "hidden/projection-bounds-payload-count-and-session-state",
      "kind": "hidden",
      "group": "resources",
      "summary": "字节/事件/会话容量与固定状态大小",
      "weight": 1,
      "critical": true
    },
    {
      "id": "hidden/projection-seeded-partitions-match-independent-fold",
      "kind": "hidden",
      "group": "regression",
      "summary": "独立生命周期折叠跨分块差分",
      "weight": 1,
      "critical": true
    }
  ]
}
