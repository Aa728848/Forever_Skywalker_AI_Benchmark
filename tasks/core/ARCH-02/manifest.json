{
  "schemaVersion": "0.1.0",
  "taskId": "ARCH-02",
  "taskVersion": "0.3.0",
  "title": "Provider 元数据与运行时拆分",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/ARCH-02/checks",
    "referencePatch": "graders/ARCH-02/reference.patch",
    "alternative": "graders/ARCH-02/alternative",
    "defectDetectors": [
      "hidden/all-shared-catalog-goes-to-both-runtimes",
      "hidden/both-outputs-preserve-catalog-order",
      "hidden/empty-and-single-element-catalogs",
      "hidden/rejected-and-sync-throwing-loads-are-retryable",
      "hidden/results-do-not-leak-or-mutate-the-catalog",
      "hidden/selection-ignores-naming-entirely",
      "hidden/shared-load-coalesces-across-runtimes",
      "hidden/unavailable-identity-does-not-leak-cached-module",
      "public/browser-side-skips-node-only",
      "public/keeps-shared-and-matching",
      "public/metadata-does-not-load-forbidden-runtime"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/keeps-shared-and-matching",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "Node 侧按元数据保留共享与 Node provider。"
    },
    {
      "id": "public/browser-side-skips-node-only",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "浏览器侧跳过 Node 专属 provider。"
    },
    {
      "id": "public/preserves-catalog-order",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "结果保持目录顺序。"
    },
    {
      "id": "public/rejects-duplicate-and-invalid-metadata",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "重复 id 与非法元数据报错。"
    },
    {
      "id": "public/empty-catalog-is-empty-result",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "空目录返回空结果。"
    },
    {
      "id": "public/metadata-does-not-load-forbidden-runtime",
      "kind": "public",
      "group": "behavior",
      "weight": 2,
      "critical": true,
      "summary": "列举元数据不加载模块，跨运行时加载必须在调用loader前拒绝。"
    },
    {
      "id": "hidden/shared-load-coalesces-across-runtimes",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "shared load coalesces across runtimes"
    },
    {
      "id": "hidden/rejected-and-sync-throwing-loads-are-retryable",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "rejected and sync throwing loads are retryable"
    },
    {
      "id": "hidden/unavailable-identity-does-not-leak-cached-module",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "unavailable identity does not leak cached module"
    },
    {
      "id": "hidden/selection-ignores-naming-entirely",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "selection ignores naming entirely"
    },
    {
      "id": "hidden/both-outputs-preserve-catalog-order",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "both outputs preserve catalog order"
    },
    {
      "id": "hidden/duplicate-id-is-rejected-regardless-of-runtime",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "duplicate id is rejected regardless of runtime"
    },
    {
      "id": "hidden/invalid-metadata-is-rejected",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "invalid metadata is rejected"
    },
    {
      "id": "hidden/empty-and-single-element-catalogs",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "empty and single element catalogs"
    },
    {
      "id": "hidden/results-do-not-leak-or-mutate-the-catalog",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "results do not leak or mutate the catalog"
    },
    {
      "id": "hidden/all-shared-catalog-goes-to-both-runtimes",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "all shared catalog goes to both runtimes"
    }
  ]
}
