{
  "schemaVersion": "0.1.0",
  "taskId": "CACHE-04",
  "taskVersion": "0.4.0",
  "title": "并发冷启动、持久化和版本隔离",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=process",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=process",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/CACHE-04/checks",
    "referencePatch": "graders/CACHE-04/reference.patch",
    "alternative": "graders/CACHE-04/alternative",
    "defectDetectors": [
      "public/cold-start-single-read",
      "public/domain-isolation",
      "hidden/resource-real-file-restart",
      "public/batch-is-one-atomic-write",
      "hidden/failed-batch-does-not-publish-partial-state",
      "hidden/batch-validation-and-call-time-copy",
      "hidden/refresh-and-snapshot-keep-queue-cut",
      "hidden/file-failure-preserves-confirmed-and-cleans",
      "hidden/file-process-crash-boundaries",
      "hidden/stale-instance-write-is-rejected",
      "hidden/rejected-instance-resyncs-then-wins",
      "hidden/recovery-journal-replays-confirmed-entries",
      "hidden/versioned-path-keeps-domain-isolation",
      "hidden/index-stays-consistent-with-entries",
      "hidden/index-reflects-removal-and-overwrite",
      "hidden/index-never-diverges-after-rejected-write",
      "hidden/index-survives-crash-recovery-replay"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/cold-start-single-read",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "public/cold-start-single-read"
    },
    {
      "id": "public/state-write-failure",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": true,
      "summary": "public/state-write-failure"
    },
    {
      "id": "public/domain-isolation",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "public/domain-isolation"
    },
    {
      "id": "hidden/boundary-corruption-vs-permission",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "hidden/boundary-corruption-vs-permission"
    },
    {
