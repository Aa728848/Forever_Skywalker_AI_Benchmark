{
  "schemaVersion": "0.1.0",
  "taskId": "LIFE-04",
  "taskVersion": "0.3.0",
  "title": "子进程故障、回收和验收重入隔离",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/LIFE-04/checks",
    "referencePatch": "graders/LIFE-04/reference.patch",
    "alternative": "graders/LIFE-04/alternative",
    "defectDetectors": [
      "hidden/late-completion-cannot-publish-old-snapshot",
      "hidden/rejects-concurrent-acceptance-without-spawning",
      "hidden/three-rounds-of-accept-and-reject",
      "hidden/timeout-reaps-real-descendant",
      "public/judge-context-does-not-reenter-acceptance",
      "public/new-snapshot-invalidates-old-passing-result",
      "public/rejects-concurrent-acceptance"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/classifies-normal-exit",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "正常退出被分类为 exited 并回收。"
    },
    {
      "id": "public/classifies-crash-and-signal",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "崩溃与信号终止被正确分类并回收。"
    },
    {
      "id": "public/rejects-concurrent-acceptance",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "在途验收期间拒绝重入，不启动第二个子进程。"
    },
    {
      "id": "public/allows-accept-after-completion",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "完成后可以再次验收。"
    },
    {
      "id": "public/reaps-every-child-even-on-failure",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "每个子进程都被回收。"
    },
    {
      "id": "public/real-child-crash-is-classified",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "启动真实Node子进程并正确识别非零退出。"
    },
    {
      "id": "public/judge-context-does-not-reenter-acceptance",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": true,
      "summary": "裁判上下文不能启动自身验收子进程。"
    },
    {
      "id": "public/new-snapshot-invalidates-old-passing-result",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "切换快照立即撤销旧通过结论。"
    },
    {
      "id": "hidden/classify-covers-every-exit-shape",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "classify covers every exit shape"
    },
    {
      "id": "hidden/accept-resolves-with-fault-and-signal",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "accept resolves with fault and signal"
    },
    {
      "id": "hidden/rejects-concurrent-acceptance-without-spawning",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "rejects concurrent acceptance without spawning"
    },
    {
      "id": "hidden/every-outcome-reaps-in-launch-order",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "every outcome reaps in launch order"
    },
    {
      "id": "hidden/kill-is-called-for-faults-and-signals-only",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "kill is called for faults and signals only"
    },
    {
      "id": "hidden/reaped-does-not-expose-the-internal-array",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "reaped does not expose the internal array"
    },
    {
      "id": "hidden/three-rounds-of-accept-and-reject",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "three rounds of accept and reject"
    },
    {
      "id": "hidden/late-completion-cannot-publish-old-snapshot",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "late completion cannot publish old snapshot"
    },
    {
      "id": "hidden/timeout-reaps-real-descendant",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "timeout reaps real descendant"
    },
    {
      "id": "hidden/spawn-errors-release-busy",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "spawn errors release busy"
    }
  ]
}
