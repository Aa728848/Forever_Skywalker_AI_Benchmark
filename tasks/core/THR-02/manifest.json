{
  "schemaVersion": "0.1.0",
  "taskId": "THR-02",
  "taskVersion": "0.1.1",
  "title": "有界线程池与任务异常",
  "runtime": "mixed",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=process",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=process",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/THR-02/checks",
    "referencePatch": "graders/THR-02/reference.patch",
    "alternative": "graders/THR-02/alternative",
    "defectDetectors": [
      "public/results-and-job-error",
      "public/state-close-drains",
      "hidden/resource-real-bounded-workers",
      "hidden/state-failed-lane-recovers"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/results-and-job-error",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "public/results-and-job-error"
    },
    {
      "id": "public/state-close-drains",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "public/state-close-drains"
    },
    {
      "id": "public/boundary-size",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "public/boundary-size"
    },
    {
      "id": "hidden/resource-real-bounded-workers",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "hidden/resource-real-bounded-workers"
    },
    {
      "id": "hidden/state-failed-lane-recovers",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": true,
      "summary": "hidden/state-failed-lane-recovers"
    }
  ]
}
