{
  "schemaVersion": "0.1.0",
  "taskId": "ARCH-03",
  "taskVersion": "0.1.0",
  "title": "替换适配器并保持公共契约",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/ARCH-03/checks",
    "referencePatch": "graders/ARCH-03/reference.patch",
    "alternative": "graders/ARCH-03/alternative",
    "defectDetectors": [
      "hidden/adapter-failures-are-normalized",
      "hidden/v2-seconds-become-milliseconds",
      "hidden/v2-status-maps-to-ok",
      "public/adapter-failures-are-normalized",
      "public/v2-seconds-become-milliseconds",
      "public/v2-status-maps-to-ok"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/legacy-adapter-keeps-contract",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "旧适配器路径契约不变。"
    },
    {
      "id": "public/v2-status-maps-to-ok",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "v2 的 status 映射到 ok，missing 不是错误。"
    },
    {
      "id": "public/v2-seconds-become-milliseconds",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "v2 的秒转成毫秒。"
    },
    {
      "id": "public/adapter-failures-are-normalized",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "两个适配器的异常都包装成 AdapterError。"
    },
    {
      "id": "public/adapter-object-is-not-mutated",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "不修改适配器对象。"
    },
    {
      "id": "hidden/legacy-adapter-keeps-contract",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的旧适配器契约。"
    },
    {
      "id": "hidden/v2-status-maps-to-ok",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的状态映射。"
    },
    {
      "id": "hidden/v2-seconds-become-milliseconds",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的单位换算。"
    },
    {
      "id": "hidden/adapter-failures-are-normalized",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的错误统一。"
    },
    {
      "id": "hidden/adapter-object-is-not-mutated",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的不可变性。"
    }
  ]
}
