{
  "schemaVersion": "0.1.0",
  "taskId": "ARCH-03",
  "taskVersion": "0.2.0",
  "title": "替换适配器并保持公共契约",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/ARCH-03/checks",
    "referencePatch": "graders/ARCH-03/reference.patch",
    "alternative": "graders/ARCH-03/alternative",
    "defectDetectors": [
      "hidden/adapter-failures-are-normalized",
      "hidden/v2-seconds-become-milliseconds",
      "hidden/v2-status-maps-to-ok",
      "public/adapter-failures-are-normalized",
      "public/v2-seconds-become-milliseconds",
      "public/v2-status-maps-to-ok",
      "public/subscriber-cancel-does-not-abort-other-readers",
      "public/old-adapter-completion-cannot-clear-new-inflight",
      "hidden/last-reader-cancel-detaches-before-retry",
      "hidden/adapter-failure-normalization-and-retry",
      "hidden/already-aborted-read-never-loads",
      "hidden/synchronous-adapter-reentry-cannot-publish-old-read"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/legacy-adapter-keeps-contract",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "旧适配器路径契约不变。"
    },
    {
      "id": "public/v2-status-maps-to-ok",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "v2 的 status 映射到 ok，missing 不是错误。"
    },
    {
      "id": "public/v2-seconds-become-milliseconds",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "v2 的秒转成毫秒。"
    },
    {
      "id": "public/adapter-failures-are-normalized",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "两个适配器的异常都包装成 AdapterError。"
    },
    {
      "id": "public/adapter-object-is-not-mutated",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "不修改适配器对象。"
    },
    {
      "id": "hidden/legacy-adapter-keeps-contract",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的旧适配器契约。"
    },
    {
      "id": "hidden/v2-status-maps-to-ok",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的状态映射。"
    },
    {
      "id": "hidden/v2-seconds-become-milliseconds",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的单位换算。"
    },
    {
      "id": "hidden/adapter-failures-are-normalized",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的错误统一。"
    },
    {
      "id": "hidden/adapter-object-is-not-mutated",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的不可变性。"
    },
    {
      "id": "public/subscriber-cancel-does-not-abort-other-readers",
      "kind": "public",
      "group": "resources",
      "weight": 2,
      "critical": true,
      "summary": "同键合并但调用方取消独立，仍有读者时保持底层请求。"
    },
    {
      "id": "public/old-adapter-completion-cannot-clear-new-inflight",
      "kind": "public",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "热替换中止旧读者，旧结果晚到不能删除新代合并记录。"
    },
    {
      "id": "hidden/last-reader-cancel-detaches-before-retry",
      "kind": "hidden",
      "group": "boundary",
      "weight": 2,
      "critical": true,
      "summary": "最后读者取消立即移除在途身份，下一次请求不复用已abort请求。"
    },
    {
      "id": "hidden/adapter-failure-normalization-and-retry",
      "kind": "hidden",
      "group": "behavior",
      "weight": 2,
      "critical": true,
      "summary": "同步和异步故障统一AdapterError并释放合并记录。"
    },
    {
      "id": "hidden/already-aborted-read-never-loads",
      "kind": "hidden",
      "group": "regression",
      "weight": 2,
      "critical": true,
      "summary": "预先取消的读者不会触发底层适配器。"
    },
    {
      "id": "hidden/synchronous-adapter-reentry-cannot-publish-old-read",
      "kind": "hidden",
      "group": "state",
      "weight": 2,
      "critical": true,
      "summary": "load调用同步重入replace，外层请求已经登记且能被新代撤销。"
    }
  ]
}
