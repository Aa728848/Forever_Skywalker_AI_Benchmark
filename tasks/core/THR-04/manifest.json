{
  "schemaVersion": "0.1.0",
  "taskId": "THR-04",
  "taskVersion": "0.2.0",
  "title": "多线程代际发布与中断恢复",
  "runtime": "mixed",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=process",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=process",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/THR-04/checks",
    "referencePatch": "graders/THR-04/reference.patch",
    "alternative": "graders/THR-04/alternative",
    "defectDetectors": [
      "public/state-old-generation-finishes-late",
      "hidden/state-three-generations-and-copy",
      "hidden/global-budget-and-superseded-queue",
      "hidden/close-cancels-queued-and-drains",
      "hidden/preaborted-admission-and-size"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/state-old-generation-finishes-late",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": true,
      "summary": "public/state-old-generation-finishes-late"
    },
    {
      "id": "public/state-cancel-preserves-confirmed",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "public/state-cancel-preserves-confirmed"
    },
    {
      "id": "public/boundary-duplicate",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "public/boundary-duplicate"
    },
    {
      "id": "hidden/resource-failure-cleans-peers",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "hidden/resource-failure-cleans-peers"
    },
    {
      "id": "hidden/state-three-generations-and-copy",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": true,
      "summary": "hidden/state-three-generations-and-copy"
    },
    {
      "id": "hidden/global-budget-and-superseded-queue",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "所有代共用真实线程上限，新代撤销旧代在途与排队任务。"
    },
    {
      "id": "hidden/close-cancels-queued-and-drains",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "关闭停止接收并确认全部线程退出与build结算。"
    },
    {
      "id": "hidden/preaborted-admission-and-size",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "无效并发预算拒绝，预取消不消耗代际。"
    }
  ]
}
