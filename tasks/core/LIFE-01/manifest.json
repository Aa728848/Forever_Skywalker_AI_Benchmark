{
  "schemaVersion": "0.1.0",
  "taskId": "LIFE-01",
  "taskVersion": "0.2.0",
  "title": "订阅与定时器释放",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/LIFE-01/checks",
    "referencePatch": "graders/LIFE-01/reference.patch",
    "alternative": "graders/LIFE-01/alternative",
    "defectDetectors": [
      "hidden/repeated-start-does-not-duplicate-ticks",
      "hidden/restart-creates-a-fresh-independent-timer",
      "hidden/stop-cancels-exactly-once-and-keeps-counting",
      "hidden/stop-marks-timer-cancelled-so-scheduler-stops-firing",
      "hidden/stop-start-cycle-releases-every-timer",
      "hidden/tick-throwing-does-not-break-lifecycle",
      "hidden/two-pollers-on-one-scheduler-are-independent",
      "public/repeated-start-keeps-one-timer",
      "public/restart-after-stop",
      "public/stop-cancels-timer"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 512,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/start-schedules-one-timer",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "start 只创建一个定时器并把它交给调度器。"
    },
    {
      "id": "public/stop-cancels-timer",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "stop 取消定时器，之后不再触发。"
    },
    {
      "id": "public/repeated-start-keeps-one-timer",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "重复 start 不得创建多个定时器。"
    },
    {
      "id": "public/restart-after-stop",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "stop 之后可以重新 start。"
    },
    {
      "id": "public/stop-without-start-is-safe",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "未启动就 stop 是安全的空操作。"
    },
    {
      "id": "public/default-interval-is-used",
      "kind": "public",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "缺省间隔为 1000ms。"
    },
    {
      "id": "hidden/repeated-start-does-not-duplicate-ticks",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "repeated start does not duplicate ticks"
    },
    {
      "id": "hidden/stop-cancels-exactly-once-and-keeps-counting",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "stop cancels exactly once and keeps counting"
    },
    {
      "id": "hidden/stop-marks-timer-cancelled-so-scheduler-stops-firing",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "stop marks timer cancelled so scheduler stops firing"
    },
    {
      "id": "hidden/stop-without-start-is-a-no-op",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "stop without start is a no op"
    },
    {
      "id": "hidden/restart-creates-a-fresh-independent-timer",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "restart creates a fresh independent timer"
    },
    {
      "id": "hidden/default-interval-and-explicit-zero",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "default interval and explicit zero"
    },
    {
      "id": "hidden/two-pollers-on-one-scheduler-are-independent",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "two pollers on one scheduler are independent"
    },
    {
      "id": "hidden/tick-throwing-does-not-break-lifecycle",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "tick throwing does not break lifecycle"
    },
    {
      "id": "hidden/stop-start-cycle-releases-every-timer",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "stop start cycle releases every timer"
    }
  ]
}
