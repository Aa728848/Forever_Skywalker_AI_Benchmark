{
  "schemaVersion": "0.1.0",
  "taskId": "PERF-02",
  "taskVersion": "0.3.0",
  "title": "长列表局部更新与渲染范围",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/PERF-02/checks",
    "referencePatch": "graders/PERF-02/reference.patch",
    "alternative": "graders/PERF-02/alternative",
    "defectDetectors": [
      "hidden/access-count-is-bounded-and-independent-of-length",
      "hidden/dom-ignores-offscreen-and-unchanged-patches",
      "hidden/dom-reuses-overlapping-window-rows",
      "public/does-not-scan-whole-list",
      "public/dom-preserves-nodes-and-focus"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 1024,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/returns-window",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "返回窗口区间与窗口内的行。"
    },
    {
      "id": "public/applies-patch-inside-window",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "只在窗口内应用更新且不修改输入。"
    },
    {
      "id": "public/does-not-scan-whole-list",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "访问次数必须与窗口大小同阶。"
    },
    {
      "id": "public/rejects-invalid-window",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "非法窗口抛 RangeError。"
    },
    {
      "id": "public/beyond-end-returns-empty-items",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "越界窗口返回空 items。"
    },
    {
      "id": "public/browser-renders-only-visible-rows",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "真实浏览器只挂载可见行。"
    },
    {
      "id": "public/dom-preserves-nodes-and-focus",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "局部更新保留节点身份与未更新行焦点。"
    },
    {
      "id": "public/browser-click-and-window-change",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "真实按钮点击更新及窗口切换。"
    },
    {
      "id": "public/browser-dispose-is-idempotent",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "销毁可重复，销毁后调用拒绝。"
    },
    {
      "id": "hidden/dom-reuses-overlapping-window-rows",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "dom reuses overlapping window rows"
    },
    {
      "id": "hidden/dom-ignores-offscreen-and-unchanged-patches",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "dom ignores offscreen and unchanged patches"
    },
    {
      "id": "hidden/browser-text-is-literal-and-updates-persist",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "browser text is literal and updates persist"
    },
    {
      "id": "hidden/browser-invalid-window-and-listener-cleanup",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "browser invalid window and listener cleanup"
    },
    {
      "id": "hidden/window-is-truncated-to-list-end-at-every-offset",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "window is truncated to list end at every offset"
    },
    {
      "id": "hidden/patch-matches-by-id-and-preserves-order",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "patch matches by id and preserves order"
    },
    {
      "id": "hidden/patch-outside-window-or-absent-leaves-window-untouched",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "patch outside window or absent leaves window untouched"
    },
    {
      "id": "hidden/access-count-is-bounded-and-independent-of-length",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "access count is bounded and independent of length"
    },
    {
      "id": "hidden/invalid-window-throws-rangeerror-without-side-effects",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": true,
      "summary": "invalid window throws rangeerror without side effects"
    },
    {
      "id": "hidden/input-rows-are-never-mutated",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "input rows are never mutated"
    }
  ]
}
