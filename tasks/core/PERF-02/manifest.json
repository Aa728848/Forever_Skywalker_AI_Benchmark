{
  "schemaVersion": "0.1.0",
  "taskId": "PERF-02",
  "taskVersion": "0.2.0",
  "title": "长列表局部更新与渲染范围",
  "runtime": "typescript",
  "runtimeRange": "node >=24.14.1 <25",
  "workspace": {
    "entries": [
      {
        "from": "task.md",
        "to": "TASK.md"
      },
      {
        "from": "starter",
        "to": "starter"
      },
      {
        "from": "public-tests",
        "to": "public-tests"
      }
    ]
  },
  "commands": {
    "public": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "public-tests/**/*.test.ts"
    ],
    "hidden": [
      "node",
      "--test",
      "--test-isolation=none",
      "--test-reporter=tap",
      "__checks__/**/*.test.ts"
    ]
  },
  "grader": {
    "checks": "graders/PERF-02/checks",
    "referencePatch": "graders/PERF-02/reference.patch",
    "alternative": "graders/PERF-02/alternative",
    "defectDetectors": [
      "hidden/accesses-do-not-grow-with-list-size",
      "public/does-not-scan-whole-list",
      "public/dom-preserves-nodes-and-focus",
      "hidden/dom-reuses-overlapping-window-rows",
      "hidden/dom-ignores-offscreen-and-unchanged-patches"
    ]
  },
  "limits": {
    "timeoutMs": 60000,
    "memoryMb": 1024,
    "cpus": 1,
    "network": false
  },
  "checks": [
    {
      "id": "public/returns-window",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "返回窗口区间与窗口内的行。"
    },
    {
      "id": "public/applies-patch-inside-window",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "只在窗口内应用更新且不修改输入。"
    },
    {
      "id": "public/does-not-scan-whole-list",
      "kind": "public",
      "group": "resources",
      "weight": 1,
      "critical": true,
      "summary": "访问次数必须与窗口大小同阶。"
    },
    {
      "id": "public/rejects-invalid-window",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "非法窗口抛 RangeError。"
    },
    {
      "id": "public/beyond-end-returns-empty-items",
      "kind": "public",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "越界窗口返回空 items。"
    },
    {
      "id": "hidden/returns-window",
      "kind": "hidden",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的窗口。"
    },
    {
      "id": "hidden/applies-patch-inside-window",
      "kind": "hidden",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的补丁命中。"
    },
    {
      "id": "hidden/accesses-do-not-grow-with-list-size",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "10 倍列表长度下访问次数不增长。"
    },
    {
      "id": "hidden/rejects-invalid-window",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的非法窗口。"
    },
    {
      "id": "hidden/beyond-end-returns-empty-items",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "隐藏样本下的越界窗口。"
    },
    {
      "id": "public/browser-renders-only-visible-rows",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "真实浏览器只挂载可见行。"
    },
    {
      "id": "public/dom-preserves-nodes-and-focus",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": true,
      "summary": "局部更新保留节点身份与未更新行焦点。"
    },
    {
      "id": "public/browser-click-and-window-change",
      "kind": "public",
      "group": "behavior",
      "weight": 1,
      "critical": false,
      "summary": "真实按钮点击更新及窗口切换。"
    },
    {
      "id": "public/browser-dispose-is-idempotent",
      "kind": "public",
      "group": "state",
      "weight": 1,
      "critical": false,
      "summary": "销毁可重复，销毁后调用拒绝。"
    },
    {
      "id": "hidden/dom-reuses-overlapping-window-rows",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "窗口移动时重用重叠行的DOM节点。"
    },
    {
      "id": "hidden/dom-ignores-offscreen-and-unchanged-patches",
      "kind": "hidden",
      "group": "resources",
      "weight": 1,
      "critical": false,
      "summary": "无变化或窗口外补丁不产生DOM变更。"
    },
    {
      "id": "hidden/browser-text-is-literal-and-updates-persist",
      "kind": "hidden",
      "group": "boundary",
      "weight": 1,
      "critical": false,
      "summary": "ID作为纯文本，窗口切换保留已更新值。"
    },
    {
      "id": "hidden/browser-invalid-window-and-listener-cleanup",
      "kind": "hidden",
      "group": "regression",
      "weight": 1,
      "critical": false,
      "summary": "错误窗口不破坏当前状态，销毁移除监听。"
    }
  ]
}
