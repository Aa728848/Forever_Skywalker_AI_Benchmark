diff --git a/starter/src/snapshot-batch.ts b/starter/src/snapshot-batch.ts
--- a/starter/src/snapshot-batch.ts
+++ b/starter/src/snapshot-batch.ts
@@ -5,6 +5,13 @@
 
 export class SnapshotBatch {
   #items:SnapshotItem[]=[];
-  get items():readonly SnapshotItem[]{return this.#items;}
-  replace(input:readonly SnapshotInput[]):readonly SnapshotItem[]{this.#items=[];for(const item of input)this.#items.push({key:item.key,value:migrate(item.value)});return this.items;}
+  get items():readonly SnapshotItem[]{return this.#items.map(item=>({key:item.key,value:{...item.value}}));}
+  replace(input:readonly SnapshotInput[]):readonly SnapshotItem[]{
+    const seen=new Set<string>();const next:SnapshotItem[]=[];
+    for(const [index,item]of input.entries()){try{
+      if(typeof item.key!=='string'||!item.key.trim()||seen.has(item.key))throw new RangeError('key');seen.add(item.key);
+      next.push({key:item.key,value:migrate(item.value)});
+    }catch(error){throw new SnapshotBatchError(index,item.key,error);}}
+    this.#items=next;return this.items;
+  }
 }
diff --git a/starter/src/snapshot.ts b/starter/src/snapshot.ts
--- a/starter/src/snapshot.ts
+++ b/starter/src/snapshot.ts
@@ -32,10 +32,32 @@
 
 export const orderStates: readonly OrderState[] = ['draft', 'placed', 'paid', 'shipped', 'cancelled'];
 
+/** v1 的状态名到 v2 的冻结映射。 */
+const legacyStates: Record<string, OrderState> = {
+  new: 'draft',
+  active: 'placed',
+  done: 'shipped',
+};
+
+function assertState(candidate: unknown, message: string): OrderState {
+  if (typeof candidate !== 'string' || !orderStates.includes(candidate as OrderState)) {
+    throw new InvalidSnapshotError(message);
+  }
+  return candidate as OrderState;
+}
+
 export function migrate(raw: unknown): Snapshot {
   if (typeof raw !== 'object' || raw === null) throw new InvalidSnapshotError('快照必须是对象');
-  // 缺陷：不检查 version，也不认 v1 的 status 字段，直接把 state 当作 v2。
-  const state = (raw as { state?: unknown }).state;
-  if (typeof state !== 'string') throw new InvalidSnapshotError('缺少 state');
-  return { version: 2, state: state as OrderState };
+  const version = (raw as { version?: unknown }).version;
+  if (version === 2) {
+    return { version: 2, state: assertState((raw as { state?: unknown }).state, 'v2 快照的 state 非法') };
+  }
+  if (version === 1) {
+    const status = (raw as { status?: unknown }).status;
+    if (typeof status !== 'string') throw new InvalidSnapshotError('v1 快照缺少 status');
+    const mapped = legacyStates[status];
+    if (mapped === undefined) throw new UnknownStateError(status);
+    return { version: 2, state: mapped };
+  }
+  throw new UnsupportedVersionError(String(version));
 }
