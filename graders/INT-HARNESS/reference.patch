+/** Decode only the selected prefix of an already validated durable stream. */
+function reconnectPrefix(stream: readonly AssistantStreamRecord[], limit: number): ReturnType<typeof expandAssistantStream> {
+  const selected: AssistantStreamRecord[] = []
+  let remaining = limit
+  for (let i = 0; remaining > 0 && i < stream.length; i += 1) {
+    const record = stream[i]!
+    if (record.type === 'chunk') { selected.push(record); remaining -= 1; continue }
+    const members = record.type === 'tool-call-chunks' ? record.args : record.texts
+    const count = Math.min(remaining, members.length)
+    const dt = record.dt.slice(0, count - 1)
+    selected.push(record.type === 'tool-call-chunks'
+      ? { ...record, dt, args: record.args.slice(0, count) }
+      : { ...record, dt, texts: record.texts.slice(0, count) })
+    remaining -= count
+  }
+  return expandAssistantStream(selected)
+}
