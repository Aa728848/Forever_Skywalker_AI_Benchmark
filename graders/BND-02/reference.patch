+/** 扫描成对的围栏块，只认 info 为 json 的块；未闭合的 json 围栏视为语法错误。 */
+function jsonBlocks(raw: string): string[] {
+  const lines=raw.split(/\r?\n/),bodies:string[]=[];
+  for(let index=0;index<lines.length;index++){
+    const opening=/^[ \t]*(\x60{3,})([^\x60]*)$/.exec(lines[index]!);if(!opening)continue;
+    const length=opening[1]!.length,info=opening[2]!.trim().toLowerCase();const body:string[]=[];let cursor=index+1;
+    for(;cursor<lines.length;cursor++){const end=/^[ \t]*(\x60{3,})[ \t]*$/.exec(lines[cursor]!);if(end&&end[1]!.length>=length)break;body.push(lines[cursor]!);}
+    if(cursor===lines.length){if(info==='json')throw new VerdictFormatError('invalid-json','unclosed json fence');break;}
+    if(info==='json')bodies.push(body.join('\n'));index=cursor;
+  }
+  return bodies;
+}
+
+function singleBody(raw: string): string {
+  const bodies = jsonBlocks(raw);
+  if (bodies.length === 0) throw new VerdictFormatError('missing-block', '缺少 json 围栏块。');
+  if (bodies.length > 1) throw new VerdictFormatError('multiple-blocks', '只能有一个 json 围栏块。');
+  return bodies[0] as string;
 }
 
