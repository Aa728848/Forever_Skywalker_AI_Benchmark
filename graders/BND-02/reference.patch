+/** 扫描成对的围栏块，只认 info 为 json 的块；未闭合的 json 围栏视为语法错误。 */
+function jsonBlocks(raw: string): string[] {
+  const lines = raw.split(/\r?\n/);
+  const bodies: string[] = [];
+  for (let index = 0; index < lines.length; index += 1) {
+    const match = /^\s*```([A-Za-z0-9_-]*)\s*$/.exec(lines[index] ?? '');
+    if (match === null) continue;
+    const info = (match[1] ?? '').toLowerCase();
+    const body: string[] = [];
+    let cursor = index + 1;
+    while (cursor < lines.length && !/^\s*```\s*$/.test(lines[cursor] ?? '')) {
+      body.push(lines[cursor] ?? '');
+      cursor += 1;
+    }
+    if (cursor >= lines.length) {
+      if (info === 'json') throw new VerdictFormatError('invalid-json', 'json 围栏块没有闭合。');
+      break;
+    }
+    if (info === 'json') bodies.push(body.join('\n'));
+    index = cursor;
+  }
+  return bodies;
+}
+
+function singleBody(raw: string): string {
+  const bodies = jsonBlocks(raw);
+  if (bodies.length === 0) throw new VerdictFormatError('missing-block', '缺少 json 围栏块。');
+  if (bodies.length > 1) throw new VerdictFormatError('multiple-blocks', '只能有一个 json 围栏块。');
+  return bodies[0] as string;
 }
 
