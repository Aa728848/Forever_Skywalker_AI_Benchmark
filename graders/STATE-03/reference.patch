@@ -47,10 +47,10 @@
 
   recover(): number {
     const entries = this.#journal.read();
-    // 缺陷：每次都从头重放整本日志，已入账的部分被重复计入。
-    for (const entry of entries) {
-      this.#balance += parseAmount(entry);
