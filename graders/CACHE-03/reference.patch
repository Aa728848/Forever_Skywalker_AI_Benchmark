diff --git a/starter/src/cache.ts b/starter/src/cache.ts
index 901dcf1..e75e254 100644
--- a/starter/src/cache.ts
+++ b/starter/src/cache.ts
@@ -38,17 +38,32 @@ export class VersionedCache {
     const cached = this.#entries.get(key);
     if (cached !== undefined) return cached.promise;
     const version = this.version(key);
-    const promise = this.#port.load(key);
-    this.#entries.set(key, { version, promise });
-    // 缺陷：结算时无条件写回缓存，被失效的旧结果会重新占据缓存。
-    promise.then(
-      value => { this.#entries.set(key, { version, promise: Promise.resolve(value) }); },
-      () => {},
-    );
-    return promise;
+    let loaded: Promise<string>;
+    try { loaded = this.#port.load(key); } catch (error) { return Promise.reject(error); }
+    // 只有发起时的版本仍是当前版本时，结果才允许留在缓存里；
+    // 无论是否入缓存，结果都要返回给本次调用方。
+    const guarded = loaded.then(value => {
+      if (this.version(key) !== version) {
+        const current = this.#entries.get(key);
+        if (current !== undefined && current.version === version) this.#entries.delete(key);
+      }
+      return value;
+    });
+    this.#entries.set(key, { version, promise: guarded });
+    guarded.catch(() => {
+      const current = this.#entries.get(key);
+      if (current !== undefined && current.version === version) this.#entries.delete(key);
+    });
+    return guarded;
   }
 
+  /** 在同一组代际上读取，失效交错只重试尚未形成一致视图的一组。 */
   async getMany(keys: readonly string[]): Promise<readonly string[]> {
-    return Object.freeze(await Promise.all(keys.map(key => this.get(key))));
+    const requested = [...keys];
+    for (;;) {
+      const versions = requested.map(key => this.version(key));
+      const values = await Promise.all(requested.map(key => this.get(key)));
+      if (requested.every((key, index) => this.version(key) === versions[index])) return Object.freeze(values);
+    }
   }
 }
