+/** 内容派生版本号：同一份字节必然得到同一个 epoch，与实例无关。 */
+function epochOf(text:string|null):number{
+ if(text===null)return 0;
+ let hash=0x811c9dc5;
+ for(let index=0;index<text.length;index+=1){hash^=text.charCodeAt(index);hash=Math.imul(hash,0x01000193)>>>0;}
+ return hash;
+}
